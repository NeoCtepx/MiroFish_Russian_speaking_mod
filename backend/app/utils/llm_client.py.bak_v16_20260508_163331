"""OpenAI-compatible LLM client with NVIDIA JSON fallback."""

import json
import re
from typing import Optional, Dict, Any, List

from openai import OpenAI

from ..config import Config


class LLMClient:
    """LLM client."""

    def __init__(
        self,
        api_key: Optional[str] = None,
        base_url: Optional[str] = None,
        model: Optional[str] = None,
    ):
        self.api_key = api_key or Config.LLM_API_KEY
        self.base_url = base_url or Config.LLM_BASE_URL
        self.model = model or Config.LLM_MODEL_NAME

        if not self.api_key:
            raise ValueError("LLM_API_KEY is not configured")

        self.client = OpenAI(api_key=self.api_key, base_url=self.base_url)

    def _is_nvidia(self) -> bool:
        return "nvidia" in (self.base_url or "").lower()

    def _clean_text(self, content: Optional[str]) -> str:
        text = content or ""
        text = re.sub(r"<think>[\s\S]*?</think>", "", text).strip()
        return text

    def _extract_json(self, text: str) -> Dict[str, Any]:
        cleaned = (text or "").strip()
        cleaned = re.sub(r"^```(?:json)?\s*", "", cleaned, flags=re.IGNORECASE)
        cleaned = re.sub(r"\s*```$", "", cleaned).strip()

        decoder = json.JSONDecoder()

        try:
            value, _ = decoder.raw_decode(cleaned)
            if isinstance(value, dict):
                return value
            return {"items": value}
        except Exception:
            pass

        starts = [pos for pos in (cleaned.find("{"), cleaned.find("[")) if pos >= 0]
        if not starts:
            raise ValueError("LLM returned no JSON: " + cleaned[:1000])

        start = min(starts)
        fragment = cleaned[start:]
        try:
            value, _ = decoder.raw_decode(fragment)
            if isinstance(value, dict):
                return value
            return {"items": value}
        except Exception as exc:
            raise ValueError("LLM returned invalid JSON: " + cleaned[:1000]) from exc

    def chat(
        self,
        messages: List[Dict[str, str]],
        temperature: float = 0.7,
        max_tokens: int = 4096,
        response_format: Optional[Dict] = None,
    ) -> str:
        kwargs = {
            "model": self.model,
            "messages": messages,
            "temperature": temperature,
            "max_tokens": max_tokens,
        }
        if response_format:
            kwargs["response_format"] = response_format

        response = self.client.chat.completions.create(**kwargs)
        content = response.choices[0].message.content
        return self._clean_text(content)

    def _chat_raw(
        self,
        messages: List[Dict[str, str]],
        temperature: float,
        max_tokens: int,
        extra_body: Optional[Dict[str, Any]] = None,
        response_format: Optional[Dict[str, Any]] = None,
    ) -> str:
        kwargs = {
            "model": self.model,
            "messages": messages,
            "temperature": temperature,
            "max_tokens": max_tokens,
        }
        if extra_body:
            kwargs["extra_body"] = extra_body
        if response_format:
            kwargs["response_format"] = response_format

        response = self.client.chat.completions.create(**kwargs)
        return self._clean_text(response.choices[0].message.content)

    def chat_json(
        self,
        messages: List[Dict[str, str]],
        temperature: float = 0.3,
        max_tokens: int = 4096,
    ) -> Dict[str, Any]:
        json_messages = [
            {
                "role": "system",
                "content": "Return only valid JSON. Do not use markdown. Do not add explanations.",
            }
        ] + list(messages)

        errors = []

        if self._is_nvidia():
            schema = {"type": "object", "additionalProperties": True}
            try:
                content = self._chat_raw(
                    messages=json_messages,
                    temperature=temperature,
                    max_tokens=max_tokens,
                    extra_body={"nvext": {"guided_json": schema}},
                )
                return self._extract_json(content)
            except Exception as exc:
                errors.append("nvidia guided_json failed: " + str(exc))

            try:
                content = self._chat_raw(
                    messages=json_messages,
                    temperature=temperature,
                    max_tokens=max_tokens,
                )
                return self._extract_json(content)
            except Exception as exc:
                errors.append("plain json prompt failed: " + str(exc))
        else:
            try:
                content = self._chat_raw(
                    messages=json_messages,
                    temperature=temperature,
                    max_tokens=max_tokens,
                    response_format={"type": "json_object"},
                )
                return self._extract_json(content)
            except Exception as exc:
                errors.append("json_object failed: " + str(exc))

            try:
                content = self._chat_raw(
                    messages=json_messages,
                    temperature=temperature,
                    max_tokens=max_tokens,
                )
                return self._extract_json(content)
            except Exception as exc:
                errors.append("plain json prompt failed: " + str(exc))

        raise ValueError("LLM JSON call failed. " + " | ".join(errors))
